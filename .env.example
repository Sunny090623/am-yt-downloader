# AM-YT-Downloader Environment Configuration

# Service Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Executable Paths (Windows: point to miniforge/conda or system binaries; Synology: yt-dlp / ffmpeg)
# Example Windows: YTDLP_PATH=C:\Users\Username\miniforge3\envs\myenv\Scripts\yt-dlp.exe
# Example Linux / Synology: YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Storage & Database Locations
DATA_DIR=./data
STORAGE_DIR=./data/storage
TEMP_DIR=./data/storage/temp
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Security & Secrets
SECRET_KEY=change-this-to-a-random-long-secret-in-production
ADMIN_PASSWORD=admin123
ADMIN_SESSION_DAYS=7

# Concurrency & Quota Limits
MAX_CONCURRENT_DOWNLOADS=2
ANONYMOUS_DAILY_VIDEO_LIMIT=5
ANONYMOUS_DAILY_ALBUM_LIMIT=5
ANONYMOUS_DAILY_SINGLE_LIMIT=10

# Retention Period (hours)
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=15
