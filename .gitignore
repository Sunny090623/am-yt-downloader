# ==============================================================================
# Git Ignore Configuration for AM-YT Downloader
# ==============================================================================

# Python Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# Node / Frontend dependencies & build artifacts
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
.eslintcache

# Database, Runtime Media & Storage (Gigabytes of media)
data/*
!data/.gitkeep
!data/logs/
data/logs/*
!data/logs/.gitkeep
!data/logs/apple_music/
data/logs/apple_music/*
!data/logs/apple_music/.gitkeep

storage/*
!storage/.gitkeep

backend/data/*
!backend/data/.gitkeep
!backend/data/logs/
backend/data/logs/*
!backend/data/logs/.gitkeep
!backend/data/logs/apple_music/
backend/data/logs/apple_music/*
!backend/data/logs/apple_music/.gitkeep

*.db
*.sqlite
*.sqlite3


# Downloaded Media Files & Temporary Fragments
*.mkv
*.mp4
*.m4a
*.flac
*.mp3
*.wav
*.zip
*.part
*.ytdl
*.temp

# Apple Music Downloader temporary download artifacts & binaries
apple-music/AM-DL*/
apple-music/AM-DL downloads/
apple-music/bin/
apple-music/apple-music-downloader
apple-music/apple-music-downloader.exe
apple-music/main.exe
apple-music/config.yaml
!apple-music/config.yaml.example


# Logs
*.log



# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Temporary / Scratch & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
scratch/
.tempmediaStorage/
.user_uploaded/
artifact.md
gpac-download.pdf
possible-solutions.md
ssh-history*.txt
ssh-docker-build-history.txt

# External reference directory
wrapper/
gpac/